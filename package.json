{
  "name": "ozon-access",
  "version": "0.1.0",
  "private": true,
  "description": "Расширение доступности главной страницы Ozon для клавиатуры и NVDA",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "vite build",
    "build:diagnostic": "vite build --mode diagnostic",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "audit": "npm run audit:fixture",
    "audit:fixture": "tsx tools/audit/cli.ts fixture",
    "audit:live": "tsx tools/audit/cli.ts live",
    "audit:groups": "tsx tools/audit/cli.ts live-groups",
    "audit:groups:arrows": "tsx tools/audit/cli.ts live-groups --groups=element-group-008,element-group-009 --allow-arrow-interactions",
    "audit:compare": "tsx tools/audit/cli.ts compare",
    "audit:behavior": "tsx tools/audit/cli.ts live --allow-safe-interactions"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "tsx": "^4.20.6",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
